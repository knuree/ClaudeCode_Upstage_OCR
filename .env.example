# Upstage API Key (https://console.upstage.ai)
UPSTAGE_API_KEY=up_your_api_key_here

# Frontend: 백엔드 API 기본 URL (로컬 개발 시 기본값 http://localhost:8000 사용)
# VITE_API_BASE_URL=http://localhost:8000

# Backend: expenses.json 저장 경로 (기본값: backend/data/expenses.json)
# Vercel 배포 시 VERCEL=1 감지하여 /tmp/expenses.json 자동 사용
# DATA_FILE_PATH=backend/data/expenses.json
